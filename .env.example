# =========================================================
# 다글로 서버 환경 변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 git 에 올라가지 않습니다)
# =========================================================

# ---- AI (필수) ----
GEMINI_API_KEY=
# 무료 키가 429 한도에 걸리면 자동으로 전환할 유료 키 (선택)
GEMINI_API_KEY_PAID=

# ---- 로그인 / 보안 ----
# 로그인 페이지 주소. 기본값 login 은 스캐너 봇이 가장 먼저 두드리는 경로라,
# 서버를 인터넷에 열어 뒀다면 아래처럼 남들이 모를 만한 값으로 바꾸는 것을 권장합니다.
#   LOGIN_PATH=gate-7f21c9
# 바꾼 뒤에는 http://<주소>/<LOGIN_PATH> 로 접속합니다. (/login 은 404 가 됩니다)
LOGIN_PATH=login

# 로그인하지 않은 브라우저가 루트(/)로 들어왔을 때의 동작.
#   on  : 로그인 페이지로 안내합니다 (기본값)
#   off : 루트까지 404 로 감춥니다. 로그인 주소를 아는 사람만 들어올 수 있습니다.
#         (로그아웃하면 404 화면이 뜨므로, 주소를 직접 입력해 다시 들어가야 합니다)
LOGIN_REDIRECT=on

# 서버를 처음 켜면 http://localhost:8000/<LOGIN_PATH> 에서 첫 관리자 계정을 만듭니다.
# 아래 두 값을 채워두면 계정이 하나도 없을 때 자동으로 관리자 계정을 만듭니다.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 로그인 세션 유지 기간(일). 기본 14
SESSION_DAYS=14

# HTTPS(리버스 프록시 등)로 서비스할 때 1 로 켜면 쿠키가 HTTPS 로만 전송됩니다.
COOKIE_SECURE=0

# 브라우저 없이 접근하는 스크립트용 토큰. 설정하면 아래 헤더로 인증할 수 있습니다.
#   X-API-Key: <값>   또는   Authorization: Bearer <값>
# 비워두면 헤더 인증 자체가 비활성화됩니다.
DAGLO_API_TOKEN=

# 다른 도메인의 프론트엔드에서 접근해야 할 때만 쉼표로 나열 (기본: 동일 출처만 허용)
# ALLOWED_ORIGINS=https://myapp.example.com

# 자막저장서버.py 인증 토큰 (공개 서버에서는 반드시 임의의 긴 문자열로 설정)
SAVE_TOKEN=

# ---- 원본 파일 삭제 동기화 ----
# 탐색기에서 `녹음파일원본` 안의 녹음을 지우면 보드도 따라 정리합니다.
#   trash     : 휴지통으로 이동 (기본값, 되돌릴 수 있음)
#   permanent : 보드와 변환 텍스트까지 완전 삭제
#   off       : 동기화 안 함
FILE_DELETE_SYNC=trash

# 네트워크 드라이브가 잠깐 끊긴 것을 삭제로 오인하지 않도록,
# 몇 번 연속으로 파일이 안 보여야 삭제할지 정합니다. (감시 주기 약 5초)
MISSING_SCANS_BEFORE_DELETE=3

# 한 번의 스캔에서 이보다 많은 보드가 사라졌다면 저장소 장애로 보고 삭제하지 않습니다.
MAX_AUTO_DELETE_PER_SCAN=50

# 녹음 폴더를 몇 초마다 확인할지 정합니다. (웹 화면의 `새로고침` 버튼은 이 주기와 무관하게
# 그 자리에서 한 번 확인하므로, 값을 늘려도 새 녹음을 바로 불러올 수 있습니다)
WATCH_INTERVAL_SECONDS=5

# ---- 웹에서 삭제 → 탐색기 동기화 (위와 반대 방향) ----
# 웹에서 보드를 지웠을 때 원본 녹음과 변환 텍스트를 어떻게 할지 정합니다.
#   trash     : 프로젝트 폴더의 `휴지통` 으로 옮깁니다 (기본값)
#               → 탐색기의 `녹음파일원본`에서 사라지고, 웹에서 복원하면 제자리로 돌아옵니다.
#   permanent : 휴지통으로 보내는 삭제에서도 파일을 즉시 지웁니다 (되돌릴 수 없습니다)
#   off       : 파일을 건드리지 않습니다. 단, 원본이 그대로 남아 있으면
#               감시 스레드가 휴지통의 보드를 다시 살려내므로 권장하지 않습니다.
WEB_DELETE_SYNC=trash

# ---- 기타 ----
# 동시에 돌릴 STT 변환 워커 수 (기본 2)
STT_WORKERS=2

# ---- 변환 정체 방지 ----
# Gemini API 한 요청의 최대 대기 시간(밀리초, 기본 900000 = 15분).
# SDK 기본값은 '무한 대기'라서, 응답이 끊기면 워커가 영원히 묶여
# 나머지 보드가 계속 '변환 대기 중'에 남는다. 반드시 유한한 값을 유지할 것.
GEMINI_TIMEOUT_MS=900000
# 5xx/타임아웃 같은 일시적 오류일 때 같은 키로 재시도할 총 횟수 (기본 3)
GEMINI_MAX_ATTEMPTS=3
# 변환 중인 보드가 이 시간(초) 동안 진행 신호가 없으면 로그에 경고를 남긴다 (기본 1800)
STT_STALL_WARN_SEC=1800
# ffmpeg 한 번 호출의 최대 시간(초, 기본 900). 멈춘 ffmpeg 이 워커를 묶는 것을 막습니다.
FFMPEG_TIMEOUT_SEC=900
# 큐에 막 넣은 작업을 '유실됐다'고 오인하지 않기 위한 유예 시간(초, 기본 30)
STT_GHOST_GRACE_SEC=30
# 서버 포트 / 바인딩 주소
PORT=8000
HOST=0.0.0.0
# 다른 DB 파일을 쓰고 싶을 때 (기본: 프로젝트 루트의 daglo.db)
# DAGLO_DB_PATH=
